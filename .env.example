# ==========================================
# AI SMART HOSPITAL MANAGEMENT SYSTEM CONFIG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local MongoDB Connection URI
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_smart_hospital?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai_smart_hospital

# JWT Secret & Token Expiration
JWT_SECRET=super_secure_ai_smart_hospital_jwt_secret_key_2026_dev
JWT_EXPIRE=7d

# AI API Key (Optional: Gemini or OpenAI API Key for external clinical LLM fallback)
AI_API_KEY=
AI_PROVIDER=gemini

# CORS Configuration
CORS_ORIGIN=*

# ==========================================
# EMAIL NOTIFICATIONS (Nodemailer)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=585
EMAIL_SECURE=false
EMAIL_USER=your_hospital_email@gmail.com
EMAIL_PASS=your_google_app_password_here
EMAIL_FROM="AI Smart Hospital <no-reply@hospital.com>"

# ==========================================
# SMS & WHATSAPP NOTIFICATIONS (Twilio)
# ==========================================
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
