# ==============================================
# AI SMART HOSPITAL MANAGEMENT SYSTEM CONFIG
# ==============================================

# Server Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ai_smart_hospital?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_smart_hospital?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=super_secret_jwt_key_replace_in_production_ai_hospital_2026
JWT_EXPIRE=7d

# AI Engine Configuration (Gemini / OpenAI API Key)
# If empty or invalid, the modular fallback deterministic AI engine will be active
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_PROVIDER=gemini

# CORS Settings (Allow local frontend during development)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
